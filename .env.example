# Supabase Configuration (client-side, Vite convention)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App URL Configuration
VITE_APP_URL=http://localhost:5173

# Supabase Edge Function secrets (set in the Supabase dashboard, never in
# client env — listed here only for local `supabase functions serve` use).
# SUPABASE_SERVICE_ROLE_KEY is auto-injected by the Supabase platform.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
